# ==========================================
# ResearchGraph Environment Configuration
# ==========================================

# Set IS_MOCK=true to run in local mock mode without a live CognoDB cloud instance
# Set IS_MOCK=false to connect directly to CognoDB via official Neo4j Bolt driver
IS_MOCK=false
USE_MOCK=false
VITE_USE_MOCK=false

# CognoDB Connection Settings (Neo4j Bolt Protocol)
# Obtain from https://console.cognodb.com
COGNODB_URI=bolt+s://your-instance.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-secure-password

# Server Settings
PORT=5000
CLIENT_URL=http://localhost:5173
